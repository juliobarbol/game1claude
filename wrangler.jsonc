{
  // FILO se publica como ASSETS ESTÁTICOS: no hay backend, no hay build.
  // Cloudflare toma el repo tal cual y sirve index.html. Cada push a `main`
  // dispara el deploy solo (hay que conectar el repo una vez desde el panel,
  // ver "Publicar" en el README).
  //
  // `not_found_handling` manda cualquier ruta desconocida al index: si alguien
  // entra a /juego o el Service Worker pide una URL vieja, igual abre el juego
  // en vez de un 404.
  "name": "game1claude",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  }
}
