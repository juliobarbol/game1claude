{
  // El sitio se publica como ASSETS ESTÁTICOS: no hay backend, no hay build.
  // Cloudflare toma el repo tal cual. Cada push a `main` dispara el deploy solo
  // (hay que conectar el repo una vez desde el panel, ver "Publicar" en el README).
  //
  // Qué queda en qué URL:
  //   /                         → el curso de inglés (index.html de la raíz)
  //   /curso/nivel-1/parte-1/…  → el syllabus y las clases
  //
  // `not_found_handling` manda cualquier ruta desconocida al index de la raíz:
  // si alguien escribe mal una URL, cae en la portada del curso en vez de un 404.
  // El nombre TIENE que coincidir con el Worker ya creado en Cloudflare
  // (`game1claude`). Si no coincide, el build despliega a otro Worker y la URL
  // de siempre se queda con la versión vieja.
  "name": "game1claude",
  "compatibility_date": "2026-07-27",
  "assets": {
    "directory": ".",
    "not_found_handling": "single-page-application"
  }
}
